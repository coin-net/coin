[Unit]
Description=Coin Full Node
After=network-online.target

[Service]
User=coin
Group=coin
WorkingDirectory=~
StateDirectory=coin
LogsDirectory=coin

Type=simple
ExecStart=/usr/bin/coind --config-file /etc/coind.conf --non-interactive
StandardOutput=null
StandardError=null

Restart=always

[Install]
WantedBy=multi-user.target
